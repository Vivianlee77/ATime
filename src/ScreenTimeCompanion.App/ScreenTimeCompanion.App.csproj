<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <AssemblyName>ScreenTimeCompanion</AssemblyName>
    <!-- WPF owns this process and requires manifest DPI awareness; WinForms is only the tray/signal sink. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ScreenTimeCompanion.Core/ScreenTimeCompanion.Core.csproj" />
    <ProjectReference Include="../ScreenTimeCompanion.Windows/ScreenTimeCompanion.Windows.csproj" />
    <ProjectReference Include="../ScreenTimeCompanion.Storage/ScreenTimeCompanion.Storage.csproj" />
  </ItemGroup>
</Project>
